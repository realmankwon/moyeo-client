{
  "name": "moyeo-mattermost-client",
  "version": "0.15.9",
  "releaseRepository": "realmankwon/moyeo-client",
  "private": true,
  "description": "A Korean messenger-style desktop client for Mattermost",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "check": "node scripts/check.cjs",
    "pack": "node scripts/release.cjs --win --dir --preview",
    "dist": "node scripts/release.cjs --win",
    "dist:win": "node scripts/release.cjs --win",
    "dist:mac": "node scripts/release.cjs --mac",
    "release:all": "npm run check && npm test && node scripts/release.cjs --all",
    "release:preview": "node scripts/release.cjs --all --preview",
    "verify:release": "node scripts/verify-release.cjs",
    "test:updates": "node tests/updates-integration.cjs",
    "generate:emoji": "node scripts/generate-emoji.cjs",
    "generate:preview": "node scripts/generate-preview.cjs",
    "test:installer": "node scripts/prepare-nsis.cjs && node tests/installer-processes.cjs && node tests/installer-exit-ui.cjs && node tests/installer-nsis.cjs && node tests/installer-upgrade.cjs",
    "test:management": "node tests/console-ui.cjs && node tests/management-pins-ui.cjs",
    "generate:icons": "node scripts/generate-icons.cjs",
    "test:themes": "node tests/themes-ui.cjs"
  },
  "devDependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@playwright/test": "^1.65.1",
    "electron": "^45.3.4",
    "electron-builder": "26.18.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "plist": "^5.1.1",
    "ws": "^8.23.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "semver": "7.8.6"
  }
}
